// 1. Satıcı Temel Bilgileri (Satıcıya özel profil detayları)
model Seller {
  id               String         @id @default(uuid())
  storeName        String         @unique // Mağaza adı (Örn: Ahmet Usta Kasap)
  email            String         @unique // Giriş için
  passwordHash     String                 // Şifre
  phone            String         @unique
  rating           Float          @default(0.0) // Genel değerlendirme puanı (Örn: 4.8)
  reviewCount      Int            @default(0)   // Toplam değerlendirme sayısı
  minBasketAmount  Decimal        @default(0)   // Minimum sepet tutarı
  isApproved       Boolean        @default(false) // Admin onay durumu (pazar yeri mantığı için şart)
  createdAt        DateTime       @default(now())

  // İlişkiler
  products         Product[]      // Satıcının ürünleri (1-to-Many)
  reviews          SellerReview[] // Satıcıya yapılan yorumlar (1-to-Many)
  hashtags         SellerHashtag[] // Satıcının hashtagleri (Many-to-Many ara tablo)
}

// 2. Ürünler Tablosu (Hangi satıcıya ait?)
model Product {
  id          String   @id @default(uuid())
  sellerId    String   // Hangi esnafa ait?
  name        String   // Ürün adı (Örn: Dana Kıymalık)
  price       Decimal  // Fiyatı
  stock       Int      // Stok adresi
  imageUrl    String?  // Ürün görseli
  isAvailable Boolean  @default(true) // Şu an satışta mı?
  createdAt   DateTime @default(now())

  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// 3. Satıcıya Özel Yorumlar ve Değerlendirmeler
model SellerReview {
  id        String   @id @default(uuid())
  sellerId  String   // Hangi satıcıya yapıldı?
  userId    String   // Hangi müşteri yaptı? (User tablosuna bağlanacak)
  rating    Int      // 1-5 arası yıldız
  comment   String?  // Yorum metni
  createdAt DateTime @default(now())

  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// 4. Hashtagler Tablosu
model Hashtag {
  id        String          @id @default(uuid())
  name      String          @unique // Örn: #organik, #glutensiz, #mahalesnafi
  sellers   SellerHashtag[]
}

// 5. Seller <-> Hashtag Ara Tablosu (Many-to-Many)
model SellerHashtag {
  sellerId  String
  hashtagId String

  seller    Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([sellerId, hashtagId])
}





model User {
  id            String              @id @default(uuid())
  username      String              @unique
  email         String              @unique
  
  // Prisma arka planda bu ilişkileri otomatik yönetir, 
  // Users tablosuna ekstra kolon açmaz!
  likedProducts UserLikedProduct[]
  following     SellerFollower[]
}

model Product {
  id            String              @id @default(uuid())
  name          String
  
  likedByUsers  UserLikedProduct[]
}

// Ara Tablo (Junction Table)
model UserLikedProduct {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([userId, productId]) // İkili birleşik anahtar (Composite Primary Key)
}

